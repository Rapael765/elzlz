NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# URL backend Baileys di server Pterodactyl (disarankan HTTPS melalui domain/reverse proxy)
BAILEYS_API_URL=https://baileys.example.com
# Harus sama dengan BAILEYS_API_KEY di environment server Pterodactyl
BAILEYS_API_KEY=GENERATE_A_LONG_RANDOM_SECRET

# Rahasia untuk callback pelanggan yang membalas STOP/BERHENTI
OPTOUT_CALLBACK_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET

# Keamanan endpoint cron Vercel
CRON_SECRET=replace-with-a-long-random-secret

# Email admin awal
INITIAL_ADMIN_EMAIL=admin@example.com
